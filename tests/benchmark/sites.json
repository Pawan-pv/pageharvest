{
  "$comment": "Pages permitted for automated testing. See docs/REAL_WORLD_TEST_BENCHMARK.md. Truth selectors are written by hand from the page source and share no code with the extension. Fields marked volatile can change on the live site, so they are compared with the live page at run time and are never expected sample values.",
  "excluded": [
    {
      "url": "https://www.scrapingcourse.com/ecommerce/",
      "reason": "Describes itself as a practice site, but its robots.txt has Disallow: /ecommerce/*."
    }
  ],
  "sites": [
    {
      "id": "books-home",
      "url": "https://books.toscrape.com/",
      "categories": [
        "E-commerce",
        "Paginated pages"
      ],
      "permission": "Sandbox. The page header says: We love being scraped! No robots.txt.",
      "structure": "Book cards in a grid, with a large category sidebar.",
      "method": "auto-detect",
      "pagination": {
        "mode": "Next Button",
        "maxPages": 3,
        "delayMs": 1000
      },
      "expectedPages": 3,
      "truth": {
        "recordSelector": "article.product_pod",
        "key": "Title",
        "fields": [
          {
            "name": "Title",
            "kind": "text",
            "selector": "h3 a",
            "attribute": "title"
          },
          {
            "name": "Price",
            "kind": "number",
            "numberFormat": "us",
            "selector": ".price_color",
            "volatile": true
          },
          {
            "name": "Link",
            "kind": "url",
            "selector": "h3 a",
            "attribute": "href"
          },
          {
            "name": "Image",
            "kind": "url",
            "selector": "img.thumbnail",
            "attribute": "src"
          }
        ],
        "pages": [
          "https://books.toscrape.com/",
          "https://books.toscrape.com/catalogue/page-2.html",
          "https://books.toscrape.com/catalogue/page-3.html"
        ]
      },
      "expectedSamples": [
        {
          "Title": "A Light in the Attic"
        },
        {
          "Title": "Tipping the Velvet"
        }
      ]
    },
