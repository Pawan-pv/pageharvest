{
  "name": "page-harvest",
  "version": "1.0.0",
  "description": "PageHarvest - Local-first website data extraction Chrome extension",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "test:release": "node scripts/release-testing/run-release.mjs --scope=all",
    "test:release:unit": "node scripts/release-testing/run-release.mjs --scope=unit",
    "test:release:e2e": "node scripts/release-testing/run-release.mjs --scope=e2e",
    "test:release:chrome": "node scripts/release-testing/run-release.mjs --scope=chrome",
    "test:release:automated": "node scripts/release-testing/run-release.mjs --scope=automated",
    "test:release:report": "node scripts/release-testing/run-release.mjs --scope=report",
    "serve:fixtures": "node tests/fixtures/serve.cjs",
    "benchmark:sites": "node scripts/benchmark/run-real-sites.mjs",
    "benchmark:performance": "node scripts/benchmark/run-performance.mjs"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.2",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "lucide-react": "^1.66.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.308",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "jszip": "^3.10.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.2.0",
    "vitest": "^3.0.7",
    "wxt": "^0.19.28"
  }
}
